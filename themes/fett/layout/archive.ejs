<section class="hero compact">
  <h1><%= page.archive ? 'Archives' : page.category ? page.category : page.tag ? page.tag : config.title %></h1>
</section>
<main class="page-shell">
  <section class="post-list">
    <% page.posts.sort('date', -1).forEach(function(post) { %>
      <% var postImage = post.image || post.cover || theme.logo; %>
      <article class="post-card">
        <a class="post-thumb" href="<%- post.external_path || url_for(post.path) %>">
          <img src="<%= postImage %>" alt="<%= post.title %>" />
        </a>
        <div class="post-body">
          <h2><a href="<%- post.external_path || url_for(post.path) %>"><%= post.title %></a></h2>
          <div class="meta"><span><i class="fa-solid fa-calendar-days"></i> <%= date(post.date, 'YYYY-MM-DD') %></span></div>
          <p class="excerpt"><%= post.excerpt || '' %></p>
        </div>
      </article>
    <% }) %>
  </section>
  <%- partial('_partial/sidebar') %>
</main>
