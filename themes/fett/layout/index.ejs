<section class="hero">
  <h1><%= config.title %></h1>
  <a class="down" href="#posts" aria-label="Go to posts"><i class="fa-solid fa-chevron-down"></i></a>
</section>

<div id="searchPanel" class="search-panel" hidden>
  <label for="searchInput">Search posts</label>
  <input id="searchInput" type="search" placeholder="Search by title, tag, category..." autocomplete="off" />
</div>

<main class="page-shell" id="posts">
  <section class="post-list" aria-label="Posts">
    <div id="postsMount">
      <% var posts = page.posts || site.posts; %>
      <% if (posts && posts.length) { %>
      <% posts.sort('date', -1).forEach(function(post) { %>
        <% var postImage = post.image || post.cover || theme.logo; %>
        <article class="post-card" data-title="<%= post.title %>" data-tags="<%= post.tags.map(t => t.name).join(' ') %>" data-category="<%= post.categories.map(c => c.name).join(' ') %>">
          <a class="post-thumb" href="<%- post.external_path || url_for(post.path) %>">
            <img src="<%= postImage %>" alt="<%= post.title %>" />
          </a>
          <div class="post-body">
            <h2><a href="<%- post.external_path || url_for(post.path) %>"><%= post.title %></a></h2>
            <div class="meta">
              <span><i class="fa-solid fa-calendar-days"></i> Created <%= date(post.date, 'YYYY-MM-DD') %></span>
              <% post.categories.forEach(function(category) { %>
                <a href="<%- url_for(category.path) %>"><i class="fa-solid fa-folder"></i> <%= category.name %></a>
              <% }) %>
              <% if (post.type) { %><span><i class="fa-solid fa-bookmark"></i> <%= post.type %></span><% } %>
              <% post.tags.forEach(function(tag) { %>
                <a href="<%- url_for(tag.path) %>"><i class="fa-solid fa-tag"></i> <%= tag.name %></a>
              <% }) %>
            </div>
            <p class="excerpt"><%= post.excerpt || strip_html(post.excerpt || post.content).substring(0, 160) %></p>
          </div>
        </article>
      <% }) %>
      <% } else { %>
        <article class="empty">No posts yet.</article>
      <% } %>
    </div>
  </section>
  <%- partial('_partial/sidebar') %>
</main>
